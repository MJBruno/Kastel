// ====================================================================
// Kastel — Fonctions mathématiques natives
// Notions : abs, min, max, sqrt, pow, floor, ceil
// Résultat attendu :
//   abs(-5) = 5
//   min(3, 8) = 3
//   max(3, 8) = 8
//   sqrt(16.0) = 4.0
//   pow(3, 4) = 81
//   floor(-2.5) = -3
//   ceil(-2.5) = -2
// ====================================================================

println("abs(-5) = {}", abs(-5));
println("min(3, 8) = {}", min(3, 8));
println("max(3, 8) = {}", max(3, 8));
println("sqrt(16.0) = {}", sqrt(16.0));
println("pow(3, 4) = {}", pow(3, 4));
println("floor(-2.5) = {}", floor(-2.5));
println("ceil(-2.5) = {}", ceil(-2.5));
