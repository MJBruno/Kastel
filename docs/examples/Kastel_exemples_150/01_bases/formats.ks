// ====================================================================
// Kastel — Formatage des nombres
// Notions : {:>6d} {:<6d} {:^6d} {:.2f} {:08.3f} {:+d} {:,} {:#x} {:#b}
// Résultat attendu :
//   [    42]
//   [42    ]
//   [  42  ]
//   3.14
//   0003.142
//   +42
//   1,234,567
//   0xff 0b1010
//   00000042
// ====================================================================

println("[{:>6d}]", 42);
println("[{:<6d}]", 42);
println("[{:^6d}]", 42);
println("{:.2f}", 3.14159);
println("{:08.3f}", 3.14159);
println("{:+d}", 42);
println("{:,}", 1234567);
println("{:#x} {:#b}", 255, 10);
println("{:08d}", 42);
