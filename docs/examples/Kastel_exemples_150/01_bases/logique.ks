// ====================================================================
// Kastel — Opérateurs logiques
// Notions : && || !
// Résultat attendu :
//   ouvert && !ferie : true
//   ouvert || ferie : true
//   !ouvert : false
// ====================================================================

let ouvert = true;
let ferie = false;

println("ouvert && !ferie : {}", ouvert && !ferie);
println("ouvert || ferie : {}", ouvert || ferie);
println("!ouvert : {}", !ouvert);
