// ====================================================================
// Kastel — Condition if / else
// Notions : if, else
// Résultat attendu :
//   Il fait bon
//   Température positive
// ====================================================================

let temperature = 25;

if temperature > 30 {
    println("Il fait chaud");
} else if temperature > 15 {
    println("Il fait bon");
} else {
    println("Il fait froid");
}

if temperature > 0 {
    println("Température positive");
}
