// ====================================================================
// Kastel — Boucle while
// Notions : while, décrément
// Résultat attendu :
//   3
//   2
//   1
//   Décollage !
// ====================================================================

let n = 3;

while n > 0 {
    println(n);
    n = n - 1;
}

println("Décollage !");
