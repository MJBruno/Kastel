// ====================================================================
// Kastel — Définir une fonction
// Notions : func, paramètres, appel
// Résultat attendu :
//   Bonjour, Alice !
//   Bonjour, Bruno !
// ====================================================================

func saluer(nom) {
    println("Bonjour, {} !", nom);
}

saluer("Alice");
saluer("Bruno");
