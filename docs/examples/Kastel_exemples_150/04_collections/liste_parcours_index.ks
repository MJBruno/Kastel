// ====================================================================
// Kastel — Parcourir avec l'index
// Notions : range(xs.size())
// Résultat attendu :
//   0: rouge
//   1: vert
//   2: bleu
// ====================================================================

let couleurs = ["rouge", "vert", "bleu"];

for i in range(couleurs.size()) {
    println("{}: {}", i, couleurs[i]);
}
