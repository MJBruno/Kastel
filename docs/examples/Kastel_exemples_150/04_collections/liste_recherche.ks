// ====================================================================
// Kastel — Rechercher dans une liste
// Notions : contains, index_of
// Résultat attendu :
//   true
//   2
//   -1
// ====================================================================

let valeurs = [3, 5, 7];

println(valeurs.contains(5));
println(valeurs.index_of(7));
println(valeurs.index_of(9));   // -1 si absent
