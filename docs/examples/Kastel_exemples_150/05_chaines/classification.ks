// ====================================================================
// Kastel — Tester le contenu
// Notions : is_digit, is_alpha, is_alphanumeric, is_empty
// Résultat attendu :
//   true
//   false
//   true
//   true
//   true
// ====================================================================

println("12345".is_digit());
println("12a".is_digit());
println("abc".is_alpha());
println("abc123".is_alphanumeric());
println("".is_empty());
