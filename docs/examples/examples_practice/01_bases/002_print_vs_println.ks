// ==================================================================
// Exemple 002 — print() contre println()
// Catégorie : Bases du langage
// ------------------------------------------------------------------
// print() n'ajoute pas de retour à la ligne, println() en ajoute un.
// ------------------------------------------------------------------
// Sortie attendue :
//   ab
//   c
// ==================================================================

print("a");          // pas de retour à la ligne
print("b");
println("");        // termine la ligne courante
println("c");
