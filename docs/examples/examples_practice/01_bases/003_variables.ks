// ==================================================================
// Exemple 003 — Déclarer des variables avec let
// Catégorie : Bases du langage
// ------------------------------------------------------------------
// let crée une variable modifiable. Le type est déduit de la valeur.
// ------------------------------------------------------------------
// Sortie attendue :
//   Bruno
//   25
// ==================================================================

let nom = "Bruno";
let age = 25;
println(nom);
println(age);
