// ==================================================================
// Exemple 004 — Annotations de type
// Catégorie : Bases du langage
// ------------------------------------------------------------------
// On peut écrire le type explicitement : int, float, str, bool.
// ------------------------------------------------------------------
// Sortie attendue :
//   10
//   2.5
//   texte
//   true
// ==================================================================

let n: int = 10;
let x: float = 2.5;
let s: str = "texte";
let ok: bool = true;
println(n);
println(x);
println(s);
println(ok);
