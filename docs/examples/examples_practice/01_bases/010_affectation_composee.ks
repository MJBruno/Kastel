// ==================================================================
// Exemple 010 — Opérateurs += -= *= %=
// Catégorie : Bases du langage
// ------------------------------------------------------------------
// Raccourcis pour modifier une variable à partir de sa valeur.
// ------------------------------------------------------------------
// Sortie attendue :
//   15
//   12
//   24
//   3
// ==================================================================

let x = 10;
x += 5;
println(x);   // 15
x -= 3;
println(x);   // 12
x *= 2;
println(x);   // 24
x %= 7;
println(x);   // 3
