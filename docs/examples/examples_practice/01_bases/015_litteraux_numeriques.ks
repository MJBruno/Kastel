// ==================================================================
// Exemple 015 — Littéraux numériques
// Catégorie : Bases du langage
// ------------------------------------------------------------------
// Hexadécimal, binaire, séparateurs _ et notation scientifique.
// ------------------------------------------------------------------
// Sortie attendue :
//   255
//   10
//   1000000
//   1000.0
//   0.25
// ==================================================================

println(0xFF);         // 255
println(0b1010);       // 10
println(1_000_000);    // séparateur de lisibilité
println(1e3);          // 1000.0
println(2.5e-1);       // 0.25
