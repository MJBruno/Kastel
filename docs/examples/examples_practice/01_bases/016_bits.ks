// ==================================================================
// Exemple 016 — Opérateurs bit à bit
// Catégorie : Bases du langage
// ------------------------------------------------------------------
// & | ^ ~ << >> travaillent sur la représentation binaire.
// ------------------------------------------------------------------
// Sortie attendue :
//   2
//   7
//   5
//   -7
//   16
//   64
// ==================================================================

println(6 & 3);     // 2
println(6 | 3);     // 7
println(6 ^ 3);     // 5
println(~6);        // -7
println(1 << 4);    // 16
println(256 >> 2);  // 64
