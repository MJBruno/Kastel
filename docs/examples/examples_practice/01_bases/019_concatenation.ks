// ==================================================================
// Exemple 019 — Concaténer du texte avec +
// Catégorie : Bases du langage
// ------------------------------------------------------------------
// + assemble deux chaînes ; utilisez str() pour un nombre.
// ------------------------------------------------------------------
// Sortie attendue :
//   Ada Lovelace
//   Age : 36
// ==================================================================

let prenom = "Ada";
let nom = "Lovelace";
println(prenom + " " + nom);
println("Age : " + str(36));
