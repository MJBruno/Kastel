// ==================================================================
// Exemple 044 — Extraire avec substring(debut, longueur)
// Catégorie : Chaînes de caractères
// ------------------------------------------------------------------
// Le second argument est une longueur, pas une position.
// ------------------------------------------------------------------
// Sortie attendue :
//   Bon
//   jour
// ==================================================================

let s = "Bonjour";
println(s.substring(0, 3));   // Bon
println(s.substring(3, 4));   // jour
