// ==================================================================
// Exemple 051 — Convertir du texte en nombre
// Catégorie : Chaînes de caractères
// ------------------------------------------------------------------
// to_int() et to_float() lisent un nombre ; les espaces autour sont ignorés.
// ------------------------------------------------------------------
// Sortie attendue :
//   50
//   7.0
// ==================================================================

println("42".to_int() + 8);
println(" 3.5 ".to_float() * 2);
