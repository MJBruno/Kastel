// ==================================================================
// Exemple 066 — Construire un texte en boucle
// Catégorie : Chaînes de caractères
// ------------------------------------------------------------------
// += sur une chaîne ajoute à la fin.
// ------------------------------------------------------------------
// Sortie attendue :
//   1,2,3,4,5
// ==================================================================

let s = "";
for i in range(1, 6) {
    s += str(i);
    if i < 5 {
        s += ",";
    }
}
println(s);
