// ==================================================================
// Exemple 073 — if / else
// Catégorie : Structures de contrôle
// ------------------------------------------------------------------
// Exécuter un bloc selon une condition (sans parenthèses obligatoires).
// ------------------------------------------------------------------
// Sortie attendue :
//   agréable
// ==================================================================

let temperature = 25;
if temperature > 30 {
    println("chaud");
} else {
    println("agréable");
}
