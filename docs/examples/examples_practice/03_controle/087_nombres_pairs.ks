// ==================================================================
// Exemple 087 — Lister les nombres pairs
// Catégorie : Structures de contrôle
// ------------------------------------------------------------------
// Un filtre avec if dans une boucle.
// ------------------------------------------------------------------
// Sortie attendue :
//   [2, 4, 6, 8, 10]
// ==================================================================

let pairs = [];
for i in range(1, 11) {
    if i % 2 == 0 {
        pairs.add(i);
    }
}
println(pairs);
