// ==================================================================
// Exemple 114 — Fonctions fléchées
// Catégorie : Fonctions, fermetures, récursion
// ------------------------------------------------------------------
// x => expression, ou (a, b) => expression.
// ------------------------------------------------------------------
// Sortie attendue :
//   36
//   5
// ==================================================================

let carre = x => x * x;
let somme = (a, b) => a + b;
println(carre(6));
println(somme(2, 3));
