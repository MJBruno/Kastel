// ==================================================================
// Exemple 129 — PGCD récursif
// Catégorie : Fonctions, fermetures, récursion
// ------------------------------------------------------------------
// pgcd(a, b) = pgcd(b, a mod b).
// ------------------------------------------------------------------
// Sortie attendue :
//   6
//   1
// ==================================================================

func pgcd(a: int, b: int) -> int {
    if b == 0 {
        return a;
    }
    return pgcd(b, a % b);
}

println(pgcd(48, 18));
println(pgcd(17, 5));
