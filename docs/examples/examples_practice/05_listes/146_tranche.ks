// ==================================================================
// Exemple 146 — Extraire une sous-liste avec slice
// Catégorie : Listes
// ------------------------------------------------------------------
// slice(debut, fin) : la fin est exclue.
// ------------------------------------------------------------------
// Sortie attendue :
//   [20, 30, 40]
//   [10, 20]
// ==================================================================

let v = [10, 20, 30, 40, 50];
println(v.slice(1, 4));
println(v.slice(0, 2));
