// ==================================================================
// Exemple 162 — Parcourir une matrice
// Catégorie : Listes
// ------------------------------------------------------------------
// Deux boucles for imbriquées.
// ------------------------------------------------------------------
// Sortie attendue :
//   21
// ==================================================================

let m = [[1, 2], [3, 4], [5, 6]];
let total = 0;
for ligne in m {
    for x in ligne {
        total += x;
    }
}
println(total);
