// ==================================================================
// Exemple 182 — Ajouter et modifier
// Catégorie : Dict, Set, Tuple, Record
// ------------------------------------------------------------------
// d[cle] = valeur crée ou remplace l'entrée.
// ------------------------------------------------------------------
// Sortie attendue :
//   {"a": 100, "b": 2}
// ==================================================================

let d = {"a": 1};
d["b"] = 2;      // ajout
d["a"] = 100;    // modification
println(d);
