// ==================================================================
// Exemple 187 — keys() et values()
// Catégorie : Dict, Set, Tuple, Record
// ------------------------------------------------------------------
// Deux listes : les clés et les valeurs, dans l'ordre d'insertion.
// ------------------------------------------------------------------
// Sortie attendue :
//   ["a", "b", "c"]
//   [1, 2, 3]
// ==================================================================

let d = {"a": 1, "b": 2, "c": 3};
println(d.keys());
println(d.values());
