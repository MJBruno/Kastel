// ==================================================================
// Exemple 403 — Arrondir un flottant
// Catégorie : Maths et algorithmes
// ------------------------------------------------------------------
// floor vers le bas, ceil vers le haut, round au plus proche.
// ------------------------------------------------------------------
// Sortie attendue :
//   3
//   4
//   4
//   -3
// ==================================================================

let x = 3.7;
println(floor(x));
println(ceil(x));
println(round(x));
println(floor(-2.5));
