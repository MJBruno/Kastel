// ==================================================================
// Exemple 404 — Aire d'un cercle
// Catégorie : Maths et algorithmes
// ------------------------------------------------------------------
// Combiner constantes et fonctions.
// ------------------------------------------------------------------
// Sortie attendue :
//   12.57
// ==================================================================

const PI = 3.141592653589793;

func aire(r: float) -> float {
    return PI * r * r;
}

println("{:.2f}", aire(2.0));
