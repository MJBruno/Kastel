// ==================================================================
// Exemple 407 — Celsius vers Fahrenheit
// Catégorie : Maths et algorithmes
// ------------------------------------------------------------------
// Une formule dans une fonction.
// ------------------------------------------------------------------
// Sortie attendue :
//   32.0
//   212.0
// ==================================================================

func c_vers_f(c: float) -> float {
    return c * 9.0 / 5.0 + 32.0;
}

println(c_vers_f(0.0));
println(c_vers_f(100.0));
