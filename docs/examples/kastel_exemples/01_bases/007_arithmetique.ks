// ==================================================================
// Exemple 007 — Les quatre opérations et le modulo
// Catégorie : Bases du langage
// ------------------------------------------------------------------
// Addition, soustraction, multiplication et reste de la division.
// ------------------------------------------------------------------
// Sortie attendue :
//   10
//   4
//   21
//   1
// ==================================================================

println(7 + 3);   // addition
println(7 - 3);   // soustraction
println(7 * 3);   // multiplication
println(7 % 3);   // modulo (reste)
