// ==================================================================
// Exemple 012 — Opérateurs logiques && || !
// Catégorie : Bases du langage
// ------------------------------------------------------------------
// ET, OU et NON sur des booléens.
// ------------------------------------------------------------------
// Sortie attendue :
//   false
//   true
//   false
// ==================================================================

let a = true;
let b = false;
println(a && b);   // false
println(a || b);   // true
println(!a);       // false
