// ==================================================================
// Exemple 023 — Largeur et alignement
// Catégorie : Bases du langage
// ------------------------------------------------------------------
// {:>5} aligne à droite, {:<5} à gauche, {:05d} complète avec des zéros.
// ------------------------------------------------------------------
// Sortie attendue :
//   [   42]
//   [42   ]
//   [00042]
// ==================================================================

println("[{:>5}]", 42);
println("[{:<5}]", 42);
println("[{:05d}]", 42);
