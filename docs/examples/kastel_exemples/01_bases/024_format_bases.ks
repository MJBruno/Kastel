// ==================================================================
// Exemple 024 — Afficher en hexadécimal et en binaire
// Catégorie : Bases du langage
// ------------------------------------------------------------------
// Les types x, X, b, o convertissent un entier.
// ------------------------------------------------------------------
// Sortie attendue :
//   ff
//   FF
//   101
//   0xff
// ==================================================================

println("{:x}", 255);    // ff
println("{:X}", 255);    // FF
println("{:b}", 5);      // 101
println("{:#x}", 255);   // 0xff
