// ==================================================================
// Exemple 037 — Nombres aléatoires
// Catégorie : Bases du langage
// ------------------------------------------------------------------
// rand() est dans [0, 1[, rand_range(a, b) dans [a, b[.
// ------------------------------------------------------------------
// Sortie attendue :
//   true
//   true
// ==================================================================

let x = rand();
println(x >= 0.0 && x < 1.0);
let n = rand_range(1, 7);          // comme un dé à 6 faces
println(n >= 1 && n < 7);
