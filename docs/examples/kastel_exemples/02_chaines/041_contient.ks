// ==================================================================
// Exemple 041 — contains, starts_with, ends_with
// Catégorie : Chaînes de caractères
// ------------------------------------------------------------------
// Tester la présence d'un morceau de texte.
// ------------------------------------------------------------------
// Sortie attendue :
//   true
//   true
//   true
//   false
// ==================================================================

let s = "programmation";
println(s.contains("gram"));
println(s.starts_with("pro"));
println(s.ends_with("ion"));
println(s.contains("xyz"));
