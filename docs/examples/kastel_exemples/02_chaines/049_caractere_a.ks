// ==================================================================
// Exemple 049 — Lire un caractère
// Catégorie : Chaînes de caractères
// ------------------------------------------------------------------
// char_at(i) (ou get(i)) renvoie le caractère à la position i.
// ------------------------------------------------------------------
// Sortie attendue :
//   K
//   l
//   s
// ==================================================================

let s = "Kastel";
println(s.char_at(0));
println(s.char_at(5));
println(s.get(2));
