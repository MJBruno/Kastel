// ==================================================================
// Exemple 082 — Passer à l'itération suivante
// Catégorie : Structures de contrôle
// ------------------------------------------------------------------
// continue saute le reste du corps de la boucle.
// ------------------------------------------------------------------
// Sortie attendue :
//   1
//   3
//   5
//   7
// ==================================================================

for i in range(1, 8) {
    if i % 2 == 0 {
        continue;
    }
    println(i);
}
