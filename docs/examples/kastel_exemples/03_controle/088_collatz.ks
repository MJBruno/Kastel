// ==================================================================
// Exemple 088 — Suite de Collatz
// Catégorie : Structures de contrôle
// ------------------------------------------------------------------
// Tant que n != 1 : n/2 s'il est pair, 3n+1 sinon.
// ------------------------------------------------------------------
// Sortie attendue :
//   8
// ==================================================================

let n = 6;
let etapes = 0;
while n != 1 {
    if n % 2 == 0 {
        n = idiv(n, 2);
    } else {
        n = 3 * n + 1;
    }
    etapes += 1;
}
println(etapes);
