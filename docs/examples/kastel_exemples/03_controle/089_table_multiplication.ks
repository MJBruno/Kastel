// ==================================================================
// Exemple 089 — Table de multiplication
// Catégorie : Structures de contrôle
// ------------------------------------------------------------------
// Afficher la table de 7.
// ------------------------------------------------------------------
// Sortie attendue :
//   7 x 1 = 7
//   7 x 2 = 14
//   7 x 3 = 21
//   7 x 4 = 28
//   7 x 5 = 35
// ==================================================================

for i in range(1, 6) {
    println("7 x {} = {}", i, 7 * i);
}
