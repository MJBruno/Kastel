// ==================================================================
// Exemple 094 — Pyramide centrée
// Catégorie : Structures de contrôle
// ------------------------------------------------------------------
// Espaces et étoiles avec repeat().
// ------------------------------------------------------------------
// Sortie attendue :
//      *
//     ***
//    *****
//   *******
// ==================================================================

let hauteur = 4;
for i in range(1, hauteur + 1) {
    println(" ".repeat(hauteur - i) + "*".repeat(2 * i - 1));
}
