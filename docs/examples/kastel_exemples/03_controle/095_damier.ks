// ==================================================================
// Exemple 095 — Damier de 4 x 4
// Catégorie : Structures de contrôle
// ------------------------------------------------------------------
// Alterner # et . selon la parité de i + j.
// ------------------------------------------------------------------
// Sortie attendue :
//   #.#.
//   .#.#
//   #.#.
//   .#.#
// ==================================================================

for i in range(4) {
    let ligne = "";
    for j in range(4) {
        ligne += (i + j) % 2 == 0 ? "#" : ".";
    }
    println(ligne);
}
