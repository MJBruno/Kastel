// ==================================================================
// Exemple 097 — continue et break ensemble
// Catégorie : Structures de contrôle
// ------------------------------------------------------------------
// Ignorer les multiples de 3, s'arrêter au-delà de 10.
// ------------------------------------------------------------------
// Sortie attendue :
//   1
//   2
//   4
//   5
//   7
//   8
//   10
// ==================================================================

for i in range(1, 20) {
    if i > 10 {
        break;
    }
    if i % 3 == 0 {
        continue;
    }
    println(i);
}
