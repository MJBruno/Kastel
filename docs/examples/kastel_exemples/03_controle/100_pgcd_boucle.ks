// ==================================================================
// Exemple 100 — PGCD (algorithme d'Euclide)
// Catégorie : Structures de contrôle
// ------------------------------------------------------------------
// Répéter (a, b) -> (b, a mod b) jusqu'à b = 0.
// ------------------------------------------------------------------
// Sortie attendue :
//   6
// ==================================================================

let a = 48;
let b = 18;
while b != 0 {
    let reste = a % b;
    a = b;
    b = reste;
}
println(a);
