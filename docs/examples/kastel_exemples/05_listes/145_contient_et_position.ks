// ==================================================================
// Exemple 145 — contains et index_of
// Catégorie : Listes
// ------------------------------------------------------------------
// Tester la présence, trouver la position (-1 si absent).
// ------------------------------------------------------------------
// Sortie attendue :
//   true
//   1
//   -1
// ==================================================================

let v = ["pomme", "poire", "kiwi"];
println(v.contains("kiwi"));
println(v.index_of("poire"));
println(v.index_of("fraise"));
