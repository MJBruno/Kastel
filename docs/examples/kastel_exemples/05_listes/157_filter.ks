// ==================================================================
// Exemple 157 — filter : garder certains éléments
// Catégorie : Listes
// ------------------------------------------------------------------
// filter(f) garde les éléments pour lesquels f renvoie true.
// ------------------------------------------------------------------
// Sortie attendue :
//   [2, 4, 6]
//   [5, 6]
// ==================================================================

let v = [1, 2, 3, 4, 5, 6];
println(v.filter(x => x % 2 == 0));
println(v.filter(x => x > 4));
