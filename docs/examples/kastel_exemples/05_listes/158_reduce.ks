// ==================================================================
// Exemple 158 — reduce : réduire à une valeur
// Catégorie : Listes
// ------------------------------------------------------------------
// reduce(f, initial) combine les éléments un à un.
// ------------------------------------------------------------------
// Sortie attendue :
//   15
//   120
// ==================================================================

let v = [1, 2, 3, 4, 5];
println(v.reduce((acc, x) => acc + x, 0));    // somme
println(v.reduce((acc, x) => acc * x, 1));    // produit
