// ==================================================================
// Exemple 159 — any et all
// Catégorie : Listes
// ------------------------------------------------------------------
// any : au moins un ; all : tous.
// ------------------------------------------------------------------
// Sortie attendue :
//   true
//   false
//   true
// ==================================================================

let v = [2, 4, 6, 7];
println(v.any(x => x % 2 == 1));
println(v.all(x => x % 2 == 0));
println(v.all(x => x > 0));
