// ==================================================================
// Exemple 163 — Transposée d'une matrice
// Catégorie : Listes
// ------------------------------------------------------------------
// Échanger lignes et colonnes.
// ------------------------------------------------------------------
// Sortie attendue :
//   [[1, 4], [2, 5], [3, 6]]
// ==================================================================

let m = [[1, 2, 3], [4, 5, 6]];
let t = [];
for j in range(3) {
    let colonne = [];
    for i in range(2) {
        colonne.add(m[i][j]);
    }
    t.add(colonne);
}
println(t);
