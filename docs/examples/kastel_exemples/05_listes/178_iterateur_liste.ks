// ==================================================================
// Exemple 178 — Un itérateur explicite
// Catégorie : Listes
// ------------------------------------------------------------------
// iter() donne un itérateur ; next() avance, has_next() teste la fin.
// ------------------------------------------------------------------
// Sortie attendue :
//   10
//   20
//   30
// ==================================================================

let it = [10, 20, 30].iter();
while it.has_next() {
    println(it.next());
}
