// ==================================================================
// Exemple 180 — Créer un dictionnaire
// Catégorie : Dict, Set, Tuple, Record
// ------------------------------------------------------------------
// Un dict associe des clés textuelles à des valeurs : {"cle": valeur}.
// ------------------------------------------------------------------
// Sortie attendue :
//   {"Ada": 36, "Alan": 41}
//   2
// ==================================================================

let ages = {"Ada": 36, "Alan": 41};
println(ages);
println(ages.size());
