// ==================================================================
// Exemple 190 — Fusionner deux dicts
// Catégorie : Dict, Set, Tuple, Record
// ------------------------------------------------------------------
// update(autre) copie toutes les entrées de l'autre dict.
// ------------------------------------------------------------------
// Sortie attendue :
//   {"x": 1, "y": 20, "z": 30}
// ==================================================================

let a = {"x": 1, "y": 2};
let b = {"y": 20, "z": 30};
a.update(b);
println(a);
