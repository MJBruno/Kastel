// ==================================================================
// Exemple 209 — Créer un tuple
// Catégorie : Dict, Set, Tuple, Record
// ------------------------------------------------------------------
// Un tuple regroupe des valeurs de types différents ; il ne change plus ensuite.
// ------------------------------------------------------------------
// Sortie attendue :
//   ("Ada", 36, true)
//   Ada
//   36
// ==================================================================

let t = ("Ada", 36, true);
println(t);
println(t[0]);
println(t[1]);
