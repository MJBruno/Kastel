// ==================================================================
// Exemple 215 — Créer un enregistrement (record)
// Catégorie : Dict, Set, Tuple, Record
// ------------------------------------------------------------------
// { nom: valeur } : les champs sont des identifiants, accessibles avec un point.
// ------------------------------------------------------------------
// Sortie attendue :
//   Bruno
//   25
//   {nom: "Bruno", age: 25}
// ==================================================================

let p = { nom: "Bruno", age: 25 };
println(p.nom);
println(p.age);
println(p);
