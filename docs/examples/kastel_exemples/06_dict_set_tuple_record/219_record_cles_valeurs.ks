// ==================================================================
// Exemple 219 — keys() et values() d'un record
// Catégorie : Dict, Set, Tuple, Record
// ------------------------------------------------------------------
// Lister les noms de champs et leurs valeurs.
// ------------------------------------------------------------------
// Sortie attendue :
//   ["nom", "age"]
//   ["Ada", 36]
// ==================================================================

let p = { nom: "Ada", age: 36 };
println(p.keys());
println(p.values());
