// ==================================================================
// Exemple 344 — count, any, all
// Catégorie : Itérateurs et range
// ------------------------------------------------------------------
// Compter ou tester tous les éléments.
// ------------------------------------------------------------------
// Sortie attendue :
//   4
//   true
//   false
// ==================================================================

let v = [2, 4, 6, 9];
println(v.iter().count());
println(v.iter().any(x => x > 8));
println(v.iter().all(x => x % 2 == 0));
