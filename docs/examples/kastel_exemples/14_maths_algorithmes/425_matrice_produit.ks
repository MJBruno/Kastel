// ==================================================================
// Exemple 425 — Produit de matrices
// Catégorie : Maths et algorithmes
// ------------------------------------------------------------------
// Trois boucles imbriquées.
// ------------------------------------------------------------------
// Sortie attendue :
//   [[19, 22], [43, 50]]
// ==================================================================

let a = [[1, 2], [3, 4]];
let b = [[5, 6], [7, 8]];
let c = [[0, 0], [0, 0]];

for i in range(2) {
    for j in range(2) {
        for k in range(2) {
            c[i][j] += a[i][k] * b[k][j];
        }
    }
}
println(c);
