
let count = 10;        // a mutable variable (int)
const PI = 3.14159;    // a constant — reassigning it is a compile error
let ratio = 3.0;       // float
let big = 1_000_000;   // underscores group digits
let hex = 0xFF;        // 255
let bin = 0b1010;      // 10
let sci = 1.5e-3;       // 1500.0

let s= "Hello";

println(type(s));