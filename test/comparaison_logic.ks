println("TEST COMPARAISONS");

println(5 == 5);
println(5 != 3);
println(5 > 3);
println(5 < 8);
println(5 >= 5);
println(5 <= 5);

println("TEST LOGIQUE");

println(true && true);
println(true && false);
println(false && true);
println(false && false);

println(true || true);
println(true || false);
println(false || true);
println(false || false);

println("TEST NOT");

println(!true);
println(!false);