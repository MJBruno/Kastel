// ============================================================
// TEST 1 — Littéral simple
// ============================================================

let value1 = 2;

match value1 {
    0 => println("zero"),
    1 => println("one"),
    2 => println("two"),
    _ => println("other"),
}


// ============================================================
// TEST 2 — Binding simple
// ============================================================

let value2 = 42;

match value2 {
    x => println(x),
}


// ============================================================
// TEST 3 — Binding + guard
// ============================================================

let value3 = 2;

match value3 {
    0 => println("zero"),
    x if x == 1 => println("one"),
    x => println(x),
}


// ============================================================
// TEST 4 — Range exclusif
// ============================================================

let value4 = 10;

match value4 {
    1..5 => println("between"),
    _ => println("other"),
}


// ============================================================
// TEST 5 — Range inclusif
// ============================================================

let value5 = 5;

match value5 {
    1..=5 => println("between"),
    _ => println("other"),
}


// ============================================================
// TEST 6 — Range début
// ============================================================

let value6 = 1;

match value6 {
    1..5 => println("between"),
    _ => println("other"),
}


// ============================================================
// TEST 7 — Range fin exclusive
// ============================================================

let value7 = 5;

match value7 {
    1..5 => println("between"),
    _ => println("other"),
}


// ============================================================
// TEST 8 — OR simple
// ============================================================

let value8 = 7;

match value8 {
    1 | 7 | 10 => println("match"),
    _ => println("other"),
}


// ============================================================
// TEST 9 — OR sans correspondance
// ============================================================

let value9 = 5;

match value9 {
    1 | 7 | 10 => println("match"),
    _ => println("other"),
}


// ============================================================
// TEST 10 — Tableau exact
// ============================================================

let value10 = [10, 20];

match value10 {
    [10, 20] => println("array match"),
    _ => println("other"),
}


// ============================================================
// TEST 11 — Tableau avec bindings
// ============================================================

let value11 = [10, 20];

match value11 {
    [x, y] => println(x + y),
    _ => println("other"),
}


// ============================================================
// TEST 12 — Tableau avec wildcard
// ============================================================

let value12 = [10, 20];

match value12 {
    [x, _] => println(x),
    _ => println("other"),
}


// ============================================================
// TEST 13 — Tableau avec mauvaise longueur
// ============================================================

let value13 = [10];

match value13 {
    [x, y] => println(x + y),
    _ => println("other"),
}


// ============================================================
// TEST 14 — Tableau imbriqué
// ============================================================

let value14 = [10, [20, 30]];

match value14 {
    [x, [y, z]] => println(x + y + z),
    _ => println("other"),
}


// ============================================================
// TEST 15 — Tableau imbriqué avec wildcard
// ============================================================

let value15 = [10, [20, 30]];

match value15 {
    [x, [_, z]] => println(x + z),
    _ => println("other"),
}


// ============================================================
// TEST 16 — Tableau imbriqué avec mauvaise longueur
// ============================================================

let value16 = [10, [20]];

match value16 {
    [x, [y, z]] => println(x + y + z),
    _ => println("other"),
}


// ============================================================
// TEST 17 — OR dans un tableau
// ============================================================

let value17 = [2, 30];

match value17 {
    [1 | 2, x] => println(x),
    _ => println("other"),
}


// ============================================================
// TEST 18 — OR dans un tableau sans correspondance
// ============================================================

let value18 = [5, 30];

match value18 {
    [1 | 2, x] => println(x),
    _ => println("other"),
}


// ============================================================
// TEST 19 — Plusieurs arms avec bindings
// ============================================================

let value19 = [5, 30];

match value19 {
    [1, x] => println(x),
    [2, x] => println(x),
    [x, y] => println(x + y),
    _ => println("other"),
}


// ============================================================
// TEST 20 — Guard sur tableau
// ============================================================

let value20 = [10, 20];

match value20 {
    [x, y] if x == 10 => println(x + y),
    _ => println("other"),
}


// ============================================================
// TEST 21 — Guard faux puis arm suivant
// ============================================================

let value21 = 10;

match value21 {
    x if x == 5 => println("five"),
    x => println(x),
}


// ============================================================
// TEST 22 — Bool
// ============================================================

let value22 = true;

match value22 {
    true => println("true"),
    false => println("false"),
}


// ============================================================
// TEST 23 — String
// ============================================================

let value23 = "hello";

match value23 {
    "hello" => println("matched"),
    _ => println("other"),
}


// ============================================================
// TEST 24 — Nil
// ============================================================

let value24 = nil;

match value24 {
    nil => println("nil"),
    _ => println("other"),
}


// ============================================================
// TEST 25 — Plusieurs valeurs successives
// ============================================================

let a = 1;
let b = 7;
let c = 20;

match a {
    1 | 2 | 3 => println("a"),
    _ => println("other"),
}

match b {
    1 | 7 | 10 => println("b"),
    _ => println("other"),
}

match c {
    1 | 7 | 10 => println("matched"),
    _ => println("c"),
}