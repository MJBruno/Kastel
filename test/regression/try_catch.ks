// ============================================================
// TEST 1 — DivisionByZero
// ============================================================

try {
    let x = 10 / 0;
    println(x);
} catch (e) {
    println(e);
}


// ============================================================
// TEST 2 — TypeError
// ============================================================

try {
    let x = 10 + true;
    println(x);
} catch (e) {
    println(e);
}


// ============================================================
// TEST 3 — Index hors limites
// ============================================================

try {
    let x = [1][100];
    println(x);
} catch (e) {
    println(e);
}


// ============================================================
// TEST 4 — Valeur non indexable
// ============================================================

try {
    let x = 42[0];
    println(x);
} catch (e) {
    println(e);
}


// ============================================================
// TEST 5 — Valeur non appelable
// ============================================================

try {
    let x = 42;
    x();
} catch (e) {
    println(e);
}


// ============================================================
// TEST 6 — Itérateur invalide
// ============================================================

try {
    let x = 42;
    for i in x {
        println(i);
    }
} catch (e) {
    println(e);
}


// ============================================================
// TEST 7 — Erreur à travers une fonction
// ============================================================

function divide() {
    let x = 10 / 0;
    println(x);
}

try {
    divide();
} catch (e) {
    println(e);
}


// ============================================================
// TEST 8 — finally après erreur runtime
// ============================================================

try {
    let x = 10 / 0;
} catch (e) {
    println(e);
} finally {
    println("finally");
}


// ============================================================
// TEST 9 — finally sans erreur
// ============================================================

try {
    println("try");
} finally {
    println("finally");
}


// ============================================================
// TEST 10 — Suite après capture
// ============================================================

try {
    let x = 10 / 0;
} catch (e) {
    println(e);
}

println("after");